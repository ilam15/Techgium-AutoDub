# AutoDub Production Configuration Example
APP_NAME="AutoDub Engine"
DEBUG=false

# Hardware
USE_GPU=true
WHISPER_MODEL_SIZE="small"
MODEL_IDLE_TIMEOUT=1200

# Redis Connection (Internal Docker Name)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# External APIs
HF_TOKEN="your_huggingface_token_here"

# Path Settings (Inside Container)
PYTHONPATH=/app
