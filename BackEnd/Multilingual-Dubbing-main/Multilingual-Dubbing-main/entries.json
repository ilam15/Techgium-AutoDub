        "text": "\u0928\u092e\u0938\u094d\u0924\u0947, \u092e\u0948\u0902 \u0938\u0928\u093e\u0925\u094d\u092f\u093e \u0939\u0942\u0902\u0964 \u092e\u0948\u0902 \u092a\u0932\u094d\u0932\u093e\u0930\u091c\u0940 \u0938\u0947 \u0939\u0942\u0902. \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u094d\u0915\u0942\u0932\u0940 \u0936\u093f\u0915\u094d\u0937\u093e \u090f\u0906\u0930\u092c\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u0936\u0928\u0932 \u0938\u094d\u0915\u0942\u0932 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0915\u0940 \u0914\u0930 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u092e\u0948\u0902 \u0936\u094d\u0930\u0947\u092f\u0947\u0936\u094d\u0935\u0930 \u092e\u0947\u0902 \u092c\u0948\u091a\u0932\u0930 \u0911\u092b \u091f\u0947\u0915\u094d\u0928\u094b\u0932\u0949\u091c\u0940 \u0915\u0940 \u092a\u0922\u093c\u093e\u0908 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902\u0964 \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 C, C++ \u0914\u0930 Java \u092e\u0947\u0902 \u092e\u091c\u092c\u0942\u0924 \u0924\u0915\u0928\u0940\u0915\u0940 \u0915\u094c\u0936\u0932 \u0939\u0948\u0902\u0964 \u092e\u0941\u091d\u0947 \u0915\u094b\u0921\u093f\u0902\u0917 \u0915\u0930\u0928\u093e \u0914\u0930 \u091b\u094b\u091f\u0947 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u093e \u092a\u0938\u0902\u0926 \u0939\u0948\u0964 \u092e\u0948\u0902 \u0924\u0947\u091c\u0940 \u0938\u0947 \u0938\u0940\u0916\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0939\u092e\u0947\u0936\u093e \u0916\u0941\u0926 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0928\u0947 \u092e\u0947\u0902 \u0926\u093f\u0932\u091a\u0938\u094d\u092a\u0940 \u0930\u0916\u0924\u093e \u0939\u0942\u0902\u0964 \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924\u094b\u0902 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0928\u